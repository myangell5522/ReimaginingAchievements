}

Achievements: {
	AchievementCopperMoonLord: {
		FriendlyName: The Toothpick
		Description: Defeat the Moon Lord while holding a Copper Shortsword for the whole fight, and without the help of minions or sentries.
	}

	AchievementEoCBiome: {
		FriendlyName: Sight Seeing
		Description: Lead the Eye of Cthulhu through every surface biome in a single night (Forest, Ocean, Snow, Desert, Jungle, Graveyard, Glowing Mushroom, The Corruption, The Crimson, and The Hallow).
	}

	AchievementBeeStatue: {
		FriendlyName: Pollen' the Strings
		Description: Have any statue-spawned enemy deliver the finishing blow to the Queen Bee.
	}

	AchievementLunaticOrange: {
		FriendlyName: Merely a Pushover
		Description: Defeat the Lunatic Cultist using only items and equipment of Orange rarity or lower. Will fail if any minions or sentries are active prior to the fight.
	}

	AchievementGoldCritter: {
		FriendlyName: Shiny Crawlies
		Description: Obtain every gold critter.
	}

	AchievementLivingWall: {
		FriendlyName: Living Wall
		Description: Reach 200 defense (190 in Classic Mode).
	}

	AchievementEoCShuriken: {
		FriendlyName: Old-Fashioned
		Description: Defeat the Eye of Cthulhu using only Shuriken for damage, no mounts, and equipment of Blue rarity or lower.
	}

	AchievementSpeed: {
		FriendlyName: Faster than Light
		Description: Reach a horizontal velocity of 250 mph or higher without mounts.
	}

	AchievementDutchman: {
		FriendlyName: Fire in the Hole
		Description: Defeat a Flying Dutchman using only Cannonballs.
	}

	AchievementDwarfFortress: {
		FriendlyName: Dwarf Fortress
		Description: Defeat a goblin invasion using only traps.
	}

	AchievementHighFive: {
		FriendlyName: High Five
		Description: Hit a Skeletron Hand with a Slap Hand.
	}

	AchievementTeamWolf: {
		FriendlyName: Team Wolf
		Description: Defeat a vampire with true melee damage while using the Lilith's Necklace transformation.
	}

	AchievementGolemTraps: {
		FriendlyName: At Its Own Game
		Description: Defeat Golem after dealing at least 5,000 direct damage with traps.
	}

	AchievementSpaTrip: {
		FriendlyName: Spa Trip
		Description: Spend 3 minutes submerged in lava with no form of lava immunity.
	}

	AchievementSlimeMount: {
		FriendlyName: Taking Back the Throne
		Description: Bounce on the Queen Slime 50 times in a single fight using the Slimy Saddle mount.
	}

	AchievementThisIsFine: {
		FriendlyName: This is Fine
		Description: Sit on a chair and drink a Teacup while afflicted with On Fire!, and either Frostburn or Cursed Inferno.
	}

	AchievementOverkill: {
		FriendlyName: Absolute Overkill
		Description: Annihilate a Blue Slime by dealing over 3,000 damage in a single Sniper Rifle shot (2,000 in Classic Mode).
	}

	AchievementDebuffs: {
		FriendlyName: How Did We Get There?
		Description: Have 15 vanilla debuffs active at once, excluding hunger-related and blue-icon debuffs and the use of a Red Potion.
	}

	AchievementCutDown: {
		FriendlyName: Cut Down to Size
		Description: Defeat any mechanical boss using only true melee damage and equipment of Light Purple rarity or lower.
	}

	AchievementBiomes: {
		FriendlyName: Tourist
		Description: Visit all the following biomes within 15 seconds: Forest, Space, Snow, Desert, The Crimson, The Corruption, Jungle, Dungeon, Ocean, Glowing Mushroom, The Hallow, The Underworld, Marble Cave, Granite Cave, Jungle Temple, and The Aether.
	}

	FloorIsLava: {
		FriendlyName: The Floor Is Lava
		Description: Defeat the Moon Lord without touching any solid surface, ground, platforms, or anything else at all.
	}

	RememberItsBest: {
		FriendlyName: ……and I remember it's best
		Description: Defeat the Avatar of Emptiness, an old one from a deceased universe.
	}

	NamelessMartyr: {
		FriendlyName: Martyr
		Description: You have passed the test.
	}

	UponAStar: {
		FriendlyName: Upon a Star
		Description: Fix Solyn's telescope and watch the stars together.
	}

	WrathOfTheStars: {
		FriendlyName: Wrath of the Stars
		Description: Witness a meteor shower while stargazing.
	}

	GreatLandlord: {
		FriendlyName: Great Landlord
		Description: Set up Solyn's camp.
	}

	ToasterPanic: {
		FriendlyName: Toaster Panic
		Description: Defeat XG-07 Mars, the reconstruction of Draedon's greatest machine grown stronger.
	}

	PerfectFlower: {
		FriendlyName: The Perfect Flower From a Perfect World
		Description: Finish building the GENESIS.
	}

	GoodAppleBite: {
		FriendlyName: Damn, this apple isn't bad...
		Description: Eat a Good Apple.
	}

	ParryNameless: {
		FriendlyName: +PARRY
		Description: Spray the Emptiness Sprayer at the Nameless Deity.
	}

	WhatDidYouExpect: {
		FriendlyName: What did you expect?
		Description: Let the Nameless Deity destroy your Rod of Harmony. This happens in a GetFixedBoi world.
	}

	SincerelyForYou: {
		FriendlyName: Sincerely For You
		Description: Rest under the tree.
	}

	MoneyIsSafe: {
		FriendlyName: At Least Your Money is Safe, Right?
		Description: Die within 2 seconds of recalling home. Not available in Journey Mode.
	}

	OnlyWayIsDown: {
		FriendlyName: The Only Way is Down
		Description: Fall from Space all the way to the bottom of the world without a hook, a minecart, or touching the ground.
	}

	MrGrinch: {
		FriendlyName: You're a Mean One, Mr. Grinch
		Description: Kill Santa Claus.
	}

	LetMeFinish: {
		FriendlyName: LET ME FINISH!
		Description: Defeat the Eye of Cthulhu before its second phase, while the eye has not yet fallen off.
	}

	ItsHarder: {
		FriendlyName: It's Harder
		Description: Defeat all three mechanical bosses before breaking a single demon or crimson altar.
	}

	ItsHardest: {
		FriendlyName: It's Hardest
		Description: Defeat the Golem with no accessories equipped and no buffs active.
	}

	WeakAreMighty: {
		FriendlyName: The Weak are Mighty
		Description: Defeat a boss with more than 10,000 health, dealing all of its damage with a Copper Shortsword.
	}

	AintACharity: {
		FriendlyName: It ain't a charity
		Description: Reach the Wall of Flesh with no town NPC but the Guide having appeared.
	}

	YouExist: {
		FriendlyName: You exist?
		Description: Summon a pre-Hardmode boss for the first time only after Hardmode has begun. The world must have been seen before Hardmode.
	}

	Noooo: {
		FriendlyName: NOOOO
		Description: Let a boss's dropped loot burn away in lava.
	}

	SufferingStronger: {
		FriendlyName: Suffering Makes You Stronger
		Description: Get healed by the Nurse 10 times in one day.
	}

	Scrooge: {
		FriendlyName: Scrooge Would Be Proud
		Description: Collect 50 gold from the Tax Collector.
	}

	RichGetRicher: {
		FriendlyName: The Rich Get Richer
		Description: Pick up 5 platinum coins in a single day.
	}

	BulletStorm: {
		FriendlyName: Bullet Storm
		Description: Fire 20 bullets in less than 30 frames.
	}

	BoomBoomBoom: {
		FriendlyName: BOOM BOOM BOOM
		Description: Buy 500 or more Dynamite from the Demolitionist in one visit.
	}

	SupremeCalamitas: {
		FriendlyName: Witching Hour
		Description: Defeat Supreme Witch, Calamitas.
	}

	DevourerOfGods: {
		FriendlyName: Worms Die Too
		Description: Defeat the Devourer of Gods.
	}

	YharonDragon: {
		FriendlyName: No More Rebirth
		Description: Defeat Yharon, Dragon of Rebirth.
	}

	ExoMechs: {
		FriendlyName: "Draedon's Choice"
		Description: Defeat the Exo Mechs.
	}

	TheProphet: {
		FriendlyName: False Prophet
		Description: Defeat the Prophet.
	}

	NihilityTwins: {
		FriendlyName: Nothing Shared
		Description: Defeat the Nihility Twins.
	}

	TheCruiser: {
		FriendlyName: End of the Cruise
		Description: Defeat the Cruiser.
	}

	Luminaris: {
		FriendlyName: Moth to a Flame
		Description: Defeat Luminaris.
	}

	HighwayToHell: {
		FriendlyName: Highway to Hell
		Description: Touch the top of the world, then reach the floor of the underworld within 90 seconds.
	}

	LookAtMe: {
		FriendlyName: Look at Me!
		Description: Reach 1700+ aggro while under the Battle and Water Candle buffs.
	}

	RideOfALifetime: {
		FriendlyName: Ride of a Lifetime
		Description: Visit the Tourist's biomes in one minecart ride, without stopping or leaving the cart. A biome that does not exist in the world is not required.
	}

	SixFeetAboveground: {
		FriendlyName: Six Feet Aboveground
		Description: An underworld enemy that spawned in hell later reaches space. Summoning it in space does not count.
	}

	Been50Years: {
		FriendlyName: It's Been 50 Years...
		Description: Reach a Lihzahrd altar in a For The Worthy world.
	}

	NoFishyBusiness: {
		FriendlyName: No Fishy Business
		Description: Land the killing blow on Duke Fishron or Dreadnautilus with a fish weapon.
	}

	SelfDefenseForDummies: {
		FriendlyName: Self Defense for Dummies
		Description: A town NPC kills a hostile monster that you have not hit.
	}

	BorrowedArsenal: {
		FriendlyName: Borrowed Arsenal
		Description: Deal all of a boss's damage with an item that drops from a different boss.
	}

	SheWouldNever: {
		FriendlyName: She Would Never Not Hurt Me!
		Description: Have the Companion Cube summoned in near-total darkness and take a hit from behind.
	}

	OhhExtraShiny: {
		FriendlyName: Ohh, Extra Shiny!
		Description: Pick up the seven large gems and Magiluminescence, and receive the Crystal Leaf from a full set of Chlorophyte armor.
	}

	Relocation: {
		FriendlyName: Relocation
		Description: Summon Duke Fishron in one ocean and land the killing blow in the other.
	}

	CartoonVillain: {
		FriendlyName: Cartoon Villain
		Description: Kill a hostile monster whose center is off-screen.
	}

	FirefistOffice: {
		FriendlyName: Firefist Office
		Description: While a boss is alive, every town NPC who was in town at the start of the fight dies, at least three of them, and you never hit them. Then the boss dies.
	}

	Unflappable: {
		FriendlyName: Unflappable
		Description: Have 12 buffs with no timer at once. Pets, mounts, and minions do not count.
	}

	ReRevitalized: {
		FriendlyName: Re-revitalized
		Description: Reach 500 health and 200 mana, use a Demon Heart, and obtain every permanent character upgrade.
	}

	FitsOnTheWall: {
		FriendlyName: This Fits Well on the Wall
		Description: Obtain the normal trophy and Master Mode relic for the progression bosses, from King Slime through the Moon Lord, plus Queen Slime, Duke Fishron, the Empress of Light, Deerclops, and Betsy.
	}

	RgbNoHitter: {
		FriendlyName: RGB No-Hitter
		Description: Stay near a daytime Empress of Light for one minute without firing or using minions, then defeat her.
	}

	VeryBadTime: {
		FriendlyName: A Very Bad Time
		Description: Finish any boss while the Dungeon Guardian is alive and chasing you.
	}

	Bowling: {
		FriendlyName: Bowling
		Description: The same boulder kills 5 enemies.
	}

	WrongKindOfEvil: {
		FriendlyName: Wrong Kind of Evil
		Description: Convert at least 200 Crimson tiles with Purple Solution, or Corruption tiles with Red Solution, in one pass of the Clentaminator.
	}

	LovelyMelody: {
		FriendlyName: Lovely Melody
		Description: Sit in a chair or lie in a bed beside a playing music box for 5 minutes without attacking or getting up.
	}

	CantStarve: {
		FriendlyName: Can't Starve, Won't Starve
		Description: Deal all of Deerclops's damage with Don't Starve weapons.
	}

	Scrooged: {
		FriendlyName: Scrooged!
		Description: House Santa Claus and the Tax Collector in the snow biome within 30 tiles of each other.
	}

	ItTakesAVillage: {
		FriendlyName: It Takes a Village
		Description: A boss dies having taken damage only from town NPCs.
	}
}
