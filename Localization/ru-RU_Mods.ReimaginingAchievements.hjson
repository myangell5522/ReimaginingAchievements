	SEED_anniversary: Celebrationmk10
	SEED_dontstarve: Константа (The Constant)
	SEED_remix: Не копай над собой (Don't dig up)
	SEED_notraps: No Traps
	SEED_zenith: Zenith (getfixedboi)
}

Live: {
	HiddenName: ??????
	MartyrName: Martyr
	MartyrHidden: Докажи, на что ты способен.
	MartyrTest: Пройди последнее испытание.
	MartyrDone: Ты прошёл испытание.
}

Achievements: {
	AchievementCopperMoonLord: {
		FriendlyName: Зубочистка
		Description: Одолейте Лунного лорда, держа в руках «{$ItemName.CopperShortsword}» на протяжении всей битвы и не используя миньонов и стражей.
	}

	AchievementEoCBiome: {
		FriendlyName: Великое зрелище
		Description: Приведите Глаз Ктулху в каждый биом поверхности за одну ночь (лес, океан, снега, пустыня, джунгли, кладбище, лес светящихся грибов, Искажение, Багрянец и Освящение).
	}

	AchievementBeeStatue: {
		FriendlyName: Статуевод
		Description: Одолейте Королеву пчел так, чтобы последний удар по ней нанес враг, призванный статуей.
	}

	AchievementLunaticOrange: {
		FriendlyName: Лёгкая добыча
		Description: Одолейте Культиста-лунатика, используя только предметы и экипировку не выше оранжевой редкости. Использование предметов более высокой редкости перед призывом босса не засчитает достижение.
	}

	AchievementGoldCritter: {
		FriendlyName: Сверкающие твари
		Description: Получите каждое золотое животное.
	}

	AchievementLivingWall: {
		FriendlyName: Живая стена
		Description: Повысьте показатель защиты до 200 ед. (190 ед. в классическом режиме).
	}

	AchievementEoCShuriken: {
		FriendlyName: Старая школа
		Description: Одолейте Глаз Ктулху, используя только сюрикены, экипировку не выше синей редкости и не пользуясь ездовыми питомцами.
	}

	AchievementSpeed: {
		FriendlyName: Быстрее света
		Description: Достигните горизонтальной скорости в 250 миль/ч (402 км/ч, или 187,5 тайла/с) без ездовых животных.
	}

	AchievementDutchman: {
		FriendlyName: Раз, два, пли!
		Description: Одолейте «Летучего голландца», используя только пушечные ядра.
	}

	AchievementDwarfFortress: {
		FriendlyName: Крепость дварфов
		Description: Одолейте армию гоблинов, используя только ловушки.
	}

	AchievementHighFive: {
		FriendlyName: Дай пять!
		Description: Ударьте руку Скелетрона предметом «{$ItemName.SlapHand}».
	}

	AchievementTeamWolf: {
		FriendlyName: Волков боятся
		Description: Убейте вампира в ближнем бою, находясь в волчьей форме от «{$ItemName.WolfMountItem}».
	}

	AchievementGolemTraps: {
		FriendlyName: Его же оружием
		Description: Одолейте Голема, нанеся ему не менее 5 000 ед. урона ловушками.
	}

	AchievementSpaTrip: {
		FriendlyName: Банька-парилка
		Description: Проведите как минимум 3 минуты в лаве, не используя ничего, дающее полную невосприимчивость к лаве.
	}

	AchievementSlimeMount: {
		FriendlyName: Вернуть престол
		Description: Подпрыгните на Королеве слизней верхом на слизне от «{$ItemName.SlimySaddle}» 50 раз за один бой.
	}

	AchievementThisIsFine: {
		FriendlyName: This is Fine
		Description: Сядьте на стул и выпейте из «{$ItemName.Teacup}», находясь под действием дебаффа «{$BuffName.OnFire}», и «{$BuffName.Frostburn}» или «{$BuffName.CursedInferno}».
	}

	AchievementOverkill: {
		FriendlyName: Абсолютная аннигиляция
		Description: Уничтожьте синего слизня, нанеся ему 3 000 ед. однократного урона из «{$ItemName.SniperRifle}» (2 000 в классическом режиме).
	}

	AchievementDebuffs: {
		FriendlyName: Как мы до этого докатились?
		Description: Попадите под влияние 15 ванильных дебаффов одновременно (за исключением связанных с голодом или имеющих синюю иконку), не используя «{$ItemName.RedPotion}».
	}

	AchievementCutDown: {
		FriendlyName: Срезать углы
		Description: Одолейте любого механического босса в истинном ближнем бою, используя экипировку не выше лиловой редкости.
	}

	AchievementBiomes: {
		FriendlyName: Турист
		Description: Посетите все следующие биомы менее чем за 15 секунд: лес, космос, снега, пустыня, Багрянец, Искажение, джунгли, темница, океан, биом светящихся грибов, Освящение, преисподняя, мраморная и гранитная пещеры, храм джунглей и Эфир.
	}

	FloorIsLava: {
		FriendlyName: Пол — это лава
		Description: Одолейте Лунного лорда, не касаясь твёрдой поверхности, земли, платформ и чего-либо ещё.
	}

	RememberItsBest: {
		FriendlyName: ……and I remember it's best
		Description: Одолейте Аватара пустоты, древнего из погибшей вселенной.
	}

	NamelessMartyr: {
		FriendlyName: Martyr
		Description: Ты прошёл испытание.
	}

	UponAStar: {
		FriendlyName: На звезде
		Description: Почините телескоп Солин и посмотрите на звёзды вместе с ней.
	}

	WrathOfTheStars: {
		FriendlyName: Гнев звёзд
		Description: Увидьте метеорный дождь во время наблюдения за звёздами.
	}

	GreatLandlord: {
		FriendlyName: Великий домовладелец
		Description: Обустройте лагерь Солин.
	}

	ToasterPanic: {
		FriendlyName: Паника тостера
		Description: Одолейте КзГ-07 Марс — усиленное восстановление величайшей машины Дрэйдона.
	}

	PerfectFlower: {
		FriendlyName: Идеальный цветок идеального мира
		Description: Завершите создание Генезиса.
	}

	GoodAppleBite: {
		FriendlyName: Чёрт, а яблоко-то ничего...
		Description: Съешьте Хорошее яблоко.
	}

	ParryNameless: {
		FriendlyName: +PARRY
		Description: Направьте «Распылитель пустоты» на Безымянное божество.
	}

	WhatDidYouExpect: {
		FriendlyName: А ты чего ждал?
		Description: Позвольте Безымянному божеству уничтожить ваш «{$ItemName.RodOfHarmony}». Это происходит только в мире Zenith (getfixedboi).
	}

	SincerelyForYou: {
		FriendlyName: Искренне для тебя
		Description: Отдохните под деревом.
	}

	MoneyIsSafe: {
		FriendlyName: Деньги-то хоть целы?
		Description: Умрите в течение 2 секунд после возвращения домой. В режиме путешествия не выполняется.
	}

	OnlyWayIsDown: {
		FriendlyName: Путь только вниз
		Description: Упадите из космоса до самого низа мира без крюка, вагонетки и касания земли.
	}

	MrGrinch: {
		FriendlyName: Ты гадкий, мистер Гринч
		Description: Убейте Санта-Клауса.
	}

	LetMeFinish: {
		FriendlyName: ДАЙ ДОГОВОРИТЬ!
		Description: Одолейте Глаз Ктулху ещё в первой фазе, до того как он раскроет пасть.
	}

	ItsHarder: {
		FriendlyName: Ещё сложнее
		Description: Одолейте всех трёх механических боссов, не сломав ни одного демонического или багряного алтаря.
	}

	ItsHardest: {
		FriendlyName: Сложнее некуда
		Description: Одолейте Голема без надетых аксессуаров и без активных баффов (дебаффы не считаются).
	}

	WeakAreMighty: {
		FriendlyName: Слабые сильны
		Description: Одолейте босса с более чем 10 000 здоровья, нанеся весь урон только оружием «{$ItemName.CopperShortsword}».
	}

	AintACharity: {
		FriendlyName: Это вам не благотворительность
		Description: Дойдите до Стены плоти так, чтобы, кроме Гида, не заселялся ни один другой житель (Старик, связанные жители и странствующие торговцы не считаются).
	}

	YouExist: {
		FriendlyName: Ты существуешь?
		Description: Впервые призовите босса простого режима уже после перехода в сложный. Мир должен быть увиден ещё до сложного режима.
	}

	Noooo: {
		FriendlyName: НЕЕЕТ
		Description: Дайте добыче босса сгореть в лаве.
	}

	SufferingStronger: {
		FriendlyName: Страдание закаляет
		Description: Полечитесь у Медсестры 10 раз за один день.
	}

	Scrooge: {
		FriendlyName: Скрудж бы одобрил
		Description: Получите у Сборщика налогов 50 золотых.
	}

	RichGetRicher: {
		FriendlyName: Богатые богатеют
		Description: Подберите 5 платины за один игровой день.
	}

	BulletStorm: {
		FriendlyName: Свинцовый ливень
		Description: Выпустите 20 пуль меньше чем за 30 кадров.
	}

	BoomBoomBoom: {
		FriendlyName: БУМ БУМ БУМ
		Description: Купите у Подрывника 500 или больше динамита за один разговор.
	}

	SupremeCalamitas: {
		FriendlyName: Ведьмин час
		Description: Одолейте Высшую ведьму, Каламитас.
	}

	DevourerOfGods: {
		FriendlyName: Черви тоже умирают
		Description: Одолейте Пожирателя богов.
	}

	YharonDragon: {
		FriendlyName: Больше никаких возрождений
		Description: Одолейте Ярона, Дракона возрождения.
	}

	ExoMechs: {
		FriendlyName: Выбор Дрэйдона
		Description: Одолейте Экзо-механизмы.
	}

	TheProphet: {
		FriendlyName: Лжепророк
		Description: Одолейте Пророка.
	}

	NihilityTwins: {
		FriendlyName: Ничто на двоих
		Description: Одолейте Близнецов Пустоты.
	}

	TheCruiser: {
		FriendlyName: Круиз окончен
		Description: Одолейте Крейсера.
	}

	Luminaris: {
		FriendlyName: Мотылёк на огонь
		Description: Одолейте Галлюциногенную моль (Luminaris).
	}

	HighwayToHell: {
		FriendlyName: Шоссе в ад
		Description: Коснитесь потолка мира и за 90 секунд доберитесь до пола преисподней. Способ передвижения любой.
	}

	LookAtMe: {
		FriendlyName: Смотрите на меня!
		Description: Поднимите агрессию врагов к себе до 1700+ при баффах «{$BuffName.Battle}» и «{$BuffName.WaterCandle}».
	}

	RideOfALifetime: {
		FriendlyName: Поездка длиною в жизнь
		Description: В одной поездке на вагонетке, не останавливаясь и не сходя с рельсов, посетите биомы «Туриста». Биома, которого нет в мире, не требуется.
	}

	SixFeetAboveground: {
		FriendlyName: Шесть футов над землёй
		Description: Враг преисподней, появившийся в аду, позже оказывается в космосе. Призыв сразу в космосе не считается.
	}

	Been50Years: {
		FriendlyName: Прошло 50 лет...
		Description: Доберитесь до алтаря ящщеров в мире «For the Worthy».
	}

	NoFishyBusiness: {
		FriendlyName: Никаких рыбных делишек
		Description: Нанесите смертельный удар Герцогу Рыброну или боссу «{$NPCName.BloodNautilus}» (Дреднаутилус) рыбным оружием.
	}

	SelfDefenseForDummies: {
		FriendlyName: Самооборона для чайников
		Description: Житель сам убивает враждебного монстра, а вы по этой цели не били.
	}

	BorrowedArsenal: {
		FriendlyName: Чужой арсенал
		Description: Весь урон по боссу нанесён предметом, который выпадает из другого босса.
	}

	SheWouldNever: {
		FriendlyName: Она бы никогда меня не ранила!
		Description: Призван «{$ItemName.CompanionCube}», вокруг почти полная темнота, и удар приходит со спины.
	}

	OhhExtraShiny: {
		FriendlyName: Ооо, ещё блестящее!
		Description: Подберите семь больших самоцветов и «{$ItemName.Magiluminescence}» и хотя бы раз получите бафф «{$BuffName.LeafCrystal}» от полного комплекта хлорофитовой брони.
	}

	Relocation: {
		FriendlyName: Переезд
		Description: Призовите Герцога Рыброна в одном океане, а смертельный удар нанесите в другом.
	}

	CartoonVillain: {
		FriendlyName: Мультяшный злодей
		Description: Убейте враждебного монстра, центр которого вне экрана.
	}

	FirefistOffice: {
		FriendlyName: Офис Огненного кулака
		Description: Пока босс жив, погибают все жители, бывшие в городе в начале боя, и их не меньше трёх. Вы их не били. Затем босс умирает.
	}

	Unflappable: {
		FriendlyName: Невозмутимый
		Description: Получите сразу 12 баффов без таймера. Питомцы, ездовые и миньоны не считаются.
	}

	ReRevitalized: {
		FriendlyName: Снова полон сил
		Description: Достигните 500 здоровья и 200 маны, используйте «{$ItemName.DemonHeart}» и получите все постоянные улучшения персонажа, включая «{$ItemName.ArtisanLoaf}», «{$ItemName.TorchGodsFavor}» и «{$ItemName.MinecartPowerup}».
	}

	FitsOnTheWall: {
		FriendlyName: Этому самое место на стене
		Description: Соберите обычный трофей и реликвию Мастера для боссов прохождения: от Короля слизней до Лунного лорда, а также Королевы слизней, Герцога Рыброна, Императрицы света, Циклоленя и Бетси.
	}

	RgbNoHitter: {
		FriendlyName: RGB без попаданий
		Description: Проведите минуту рядом с дневной Императрицей света без выстрелов и миньонов, затем победите её.
	}

	VeryBadTime: {
		FriendlyName: Очень плохое время
		Description: Добейте любого босса, пока Страж темницы жив и преследует вас.
	}

	Bowling: {
		FriendlyName: Боулинг
		Description: Один и тот же валун убивает 5 врагов.
	}

	WrongKindOfEvil: {
		FriendlyName: Не то зло
		Description: С помощью предмета «{$ItemName.Clentaminator}» превратите не меньше 200 блоков Багрянца раствором «{$ItemName.PurpleSolution}» или Искажения раствором «{$ItemName.RedSolution}» за одну обработку.
	}

	LovelyMelody: {
		FriendlyName: Прекрасная мелодия
		Description: 5 минут сидите на стуле или лежите в кровати рядом с включённой музыкальной шкатулкой, не атакуя и не вставая.
	}

	CantStarve: {
		FriendlyName: Не могу голодать и не буду
		Description: Весь урон по Циклоленю нанесён только оружием из Don't Starve.
	}

	Scrooged: {
		FriendlyName: Скрудж!
		Description: Заселите Санта-Клауса и Сборщика налогов в снежном биоме не дальше 30 блоков друг от друга.
	}

	ItTakesAVillage: {
		FriendlyName: Нужна целая деревня
		Description: Босс умирает, а урон по нему нанесли только жители.
	}

	PureInsanity: {
		FriendlyName: Чистое безумие
		Description: До хардмода очистите мир от Искажения и Багрянца до последнего блока, ни разу не используя растворы для «{$ItemName.Clentaminator}» и «{$ItemName.HolyWater}».
	}

	TisButAScratch: {
		FriendlyName: Это всего лишь царапина
		Description: Получите один удар на 400+ урона и проживите после него ещё 20 секунд.
	}

	BiggerFish: {
		FriendlyName: Всегда найдётся рыба побольше
		Description: Победите Герцога Рыброна, весь бой оставаясь в воде и без «{$BuffName.CuteFishronMount}».
	}

	ImaFiringMahLazer: {
		FriendlyName: Я ЗАРЯЖАЮ СВОЙ ЛАЗЕР
		Description: Победите Лунного лорда, нанося весь урон оружием «{$ItemName.LastPrism}».
	}

	SlimeSlayer: {
		FriendlyName: Слизнеборец
		Description: Сразитесь с Королём и Королевой слизней одновременно и убейте обоих.
	}

	LikeANinja: {
		FriendlyName: Как ниндзя
		Description: Победите босса, когда все надетые аксессуары окрашены красителем «{$ItemName.ShadowDye}», а стена за вами покрашена краской «{$ItemName.ShadowPaint}».
	}

	GetMeOuttaHere: {
		FriendlyName: Вытащите меня отсюда!
		Description: Получите дебаффы «{$BuffName.Webbed}», «{$BuffName.Stoned}» и «{$BuffName.Frozen}» одновременно, сразу после того как висели на крюке (паутина сама срывает крюк).
	}

	GoodRiddance: {
		FriendlyName: Отличное избавление... Стоп, что?
		Description: Пусть Искажение, Багрянец и Освящение вместе покроют 100% мира.
	}

	MassacreByCat: {
		FriendlyName: Кошачья резня
		Description: Нанесите в сумме 2500 урона одним снарядом «{$ItemName.Meowmere}».
	}

